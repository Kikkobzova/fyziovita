---
interface Props {
  targetId?: string;
  label?: string;
}

const { targetId = 'obsah', label = 'Přeskočit na obsah' } = Astro.props;
---

<a
  href={`#${targetId}`}
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-primary focus:px-5 focus:py-2.5 focus:font-semibold focus:text-white focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary-hover"
>
  {label}
</a>
