---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { getSteps, WHAT_TO_BRING } from '../../data/steps';
import photoClinic from '../../assets/physio-vita-photos/ordinace-fyziovita.jpg';
import photoSquat from '../../assets/physio-vita-photos/korekce-drepu-kettlebell.jpg';

const steps = getSteps();
---

<section id="prubeh" class="bg-surface py-16 md:py-24">
  <Container>
    <SectionHeading
      eyebrow="Průběh terapie"
      title="Co vás čeká na první návštěvě"
      description="Každé setkání probíhá v klidu a s plnou pozorností věnovanou vašemu tělu. Věnuji se pouze vám a společně najdeme cestu k úlevě i dlouhodobému zlepšení."
      withDots={true}
      align="center"
    />

    <div class="mt-14 grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Ľavý stĺpec – 4 číslované kroky + Čo si vziať */}
      <div class="lg:col-span-7 flex flex-col">
        <div class="relative space-y-8 pl-2">
          {/* Zvislá vodiaca línia */}
          <div
            class="absolute top-5 bottom-5 left-6 w-0.5 bg-line -z-1"
            aria-hidden="true"
          ></div>

          {
            steps.map((step) => (
              <div class="relative flex items-start gap-5">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-white shadow-sm ring-4 ring-white">
                  {step.number}
                </div>
                <div class="pt-1">
                  <h3 class="text-lg font-bold text-ink md:text-xl">
                    {step.title}
                  </h3>
                  <p class="mt-1.5 text-base leading-relaxed text-muted">
                    {step.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>

        {/* Box: Čo si vziať so sebou */}
        <div class="mt-10 rounded-2xl bg-tint p-6 border border-line/60">
          <h4 class="flex items-center gap-2 text-base font-bold text-ink">
            <Icon name="info" size={20} class="text-primary" />
            <span>Co si vzít s sebou na první terapii</span>
          </h4>
          <ul class="mt-3.5 space-y-2 text-sm text-ink leading-relaxed">
            {
              WHAT_TO_BRING.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-primary mt-1 shrink-0">
                    <Icon name="check" size={15} strokeWidth={2.5} />
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {/* Pravý stĺpec – 2 fotografie (na mobile kompaktné nad sebou, na PC v pôvodnom pomere s 2. fotkou ako obdĺžnik na výšku) */}
      <div class="lg:col-span-5 flex flex-col gap-4 lg:gap-6 max-w-[280px] sm:max-w-[320px] lg:max-w-[340px] mx-auto w-full">
        {/* Fotografia 1: Vybavenie a priestor ordinácie */}
        <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-xs transition-shadow hover:shadow-md">
          <Image
            src={photoClinic}
            alt="Příjemné a plně vybavené prostředí ordinace FyzioVita Brno"
            class="aspect-4/3 w-full object-cover transition-transform duration-500 hover:scale-[1.02]"
            widths={[280, 400, 700]}
            sizes="(max-width: 640px) 280px, (max-width: 1024px) 320px, 340px"
          />
        </div>

        {/* Fotografia 2: Individuálna korekcia pohybu a cvičenie (na PC obdĺžnik na výšku aspect-[4/5]) */}
        <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-xs transition-shadow hover:shadow-md">
          <Image
            src={photoSquat}
            alt="Fyzioterapeutka Kristýna Kobzová koriguje provedení cviku s kettlebellem"
            class="aspect-4/3 lg:aspect-[4/5] w-full object-cover object-center transition-transform duration-500 hover:scale-[1.02]"
            widths={[280, 400, 700]}
            sizes="(max-width: 640px) 280px, (max-width: 1024px) 320px, 340px"
          />
        </div>
      </div>
    </div>
  </Container>
</section>
