---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';
import { getFaqList } from '../../data/faq';

const faqItems = getFaqList();
---

<section id="faq" class="bg-surface-alt py-16 md:py-24">
  <Container>
    <SectionHeading
      eyebrow="Časté dotazy"
      title="Na co se klienti často ptají"
      description="Odpovědi na nejčastější otázky ohledně objednání, průběhu terapie i praktických informací."
      withDots={true}
      align="center"
    />

    {/* Natívny prístupný akordeón bez nutnosti JavaScriptu */}
    <div class="mt-12 mx-auto max-w-3xl space-y-4">
      {
        faqItems.map((item) => (
          <details class="group rounded-[var(--radius-card)] border border-line bg-white p-6 shadow-xs transition-colors open:border-primary/40 open:shadow-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink text-base md:text-lg select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary rounded-md">
              <span>{item.question}</span>
              <span class="shrink-0 text-primary transition-transform duration-200 group-open:rotate-180">
                <Icon name="chevron-down" size={20} />
              </span>
            </summary>
            <div class="mt-3.5 pt-3 border-t border-line/50 text-base leading-relaxed text-muted">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </Container>
</section>
