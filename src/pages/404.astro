---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/layout/Footer.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title={`Stránka nenalezena (404) | ${SITE.name}`}
  description="Omlouváme se, ale požadovaná stránka nebyla nalezena."
  noindex={true}
>
  <section class="py-20 md:py-32">
    <Container class="text-center">
      <div class="mx-auto max-w-xl rounded-[var(--radius-card)] border border-line bg-white p-8 md:p-12 shadow-sm">
        <span class="text-6xl font-extrabold tracking-tight text-primary md:text-7xl">
          404
        </span>

        <h1 class="mt-4 text-2xl font-bold text-ink md:text-3xl">
          Stránka nebyla nalezena
        </h1>

        <p class="mt-3 text-base leading-relaxed text-muted">
          Omlouváme se, ale stránka, kterou hledáte, neexistuje, byla přesunuta nebo je dočasně nedostupná.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="/" variant="primary" size="lg">
            <span>Zpět na úvodní stránku</span>
            <Icon name="arrow-right" size={16} />
          </Button>

          <Button href="/#sluzby" variant="secondary" size="lg">
            <span>Přehled služeb</span>
          </Button>
        </div>

        <div class="mt-10 border-t border-line/60 pt-6 text-xs text-muted">
          <p>
            Hledáte kontakt nebo rezervaci? Pokračujte na{' '}
            <a href="/#kontakt" class="font-bold text-primary underline">
              kontaktní informace
            </a>.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <Footer slot="footer" />
</BaseLayout>
